<%# Loads Redmine core's Chart.js v4 (the ESM build in vendor/javascript) and
	exposes it as the classic global `Chart`. Chart-building code must wait on
	window.chartjsReady. Safe to render multiple times on one page. %>
<%= javascript_tag type: "module" do %>
	window.chartjsReady = window.chartjsReady || import("<%= j asset_path('chart.min.js') %>").then(function(m) {
		window.Chart = m.default;
		return m.default;
	});
<% end %>
