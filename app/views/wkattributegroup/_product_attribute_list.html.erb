<h2><%= l(:label_attribute_plural) %></h2>
<%= stylesheet_link_tag 'wk-time', :plugin => "redmine_wktime" %>
<div class="wk-contextual">
	<a href="#" id="add-attribute" data-group-id="<%= attrGroup.id %>" class="icon icon-add">
		<%= l(:label_new_product_attribute) %>
	</a>
</div>

<div id="attribute_container">
	<% if @groupAttrEntries.present? %>
		<div class="autoscroll">
			<table id="attribute_table" class="list time-entries">
				<thead>
					<tr>
						<th class="lbl-txt-align">#</th>
						<th class="lbl-txt-align"><%= l(:field_name) %></th>
						<th class="lbl-txt-align"><%= l(:field_description) %></th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					<% @groupAttrEntries.each do |entry| %>
						<tr id="attribute_row_<%= entry.id %>">
							<td class="lbl-txt-align"><%=h entry.id %></td>
							<td>
								<input type="text" name="attribute_names[]" value="<%= entry.name %>">
								<input type="hidden" name="attribute_ids[]" value="<%= entry.id %>">
							</td>
							<td>
								<textarea name="attribute_descriptions[]"><%= entry.description %></textarea>
							</td>
							<td align="center">
								<% if controller.hasDeletePermission %>
									<%= link_to sprite_icon('del'), {:controller => controller.controller_name, :action => 'destroy_product_attribute', :product_attribute_id => entry.id, id: entry.id, :tab => controller.controller_name}, :data => {:confirm => l(:text_are_you_sure)}, :method => :delete, :title => l(:button_delete) %>
								<% end %>
							</td>
						</tr>
					<% end %>
				</tbody>
			</table>
		</div>
		<span class="pagination"><%= pagination_links_full @entry_pages, @entry_count %></span>
	<% else %>
		<label><b><%= l(:label_no_data) %></b></label>
	<% end %>
</div>

<%= javascript_tag do %>
	// Header used when the table is built on the fly for an empty group.
	var attributeTableHtml = `
		<div class="autoscroll">
			<table id="attribute_table" class="list time-entries">
				<thead>
					<tr>
						<th class="lbl-txt-align">#</th>
						<th class="lbl-txt-align"><%= escape_javascript(l(:field_name)) %></th>
						<th class="lbl-txt-align"><%= escape_javascript(l(:field_description)) %></th>
						<th></th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>`;

	var attributeRowHtml = `
		<tr>
			<td></td>
			<td>
				<input type="text" name="attribute_names[]">
				<input type="hidden" name="attribute_ids[]" value="">
			</td>
			<td>
				<textarea name="attribute_descriptions[]"></textarea>
			</td>
			<td align="center">
				<button type="button" class="remove-row"><%= escape_javascript(l(:button_delete)) %></button>
			</td>
		</tr>`;

	$(document).on('click', '#add-attribute', function(e) {
		e.preventDefault();
		if ($('#attribute_table').length === 0) {
			$('#attribute_container').html(attributeTableHtml);
		}
		$('#attribute_table tbody').prepend(attributeRowHtml);
	});

	$(document).on('click', '.remove-row', function() {
		$(this).closest('tr').remove();
	});
<% end %>
