<%= title l(:label_referrals) %>
<%= render partial: "wkattendance/render_hr_tabs" %>


<fieldset>
  <%= form_tag({}, method: "get", id:"query_form") do %>
		<%= hidden_field_tag("searchlist", controller_name) %>
		<%= hidden_field_tag("tab", controller_name) %>
    <% year = (1970..Time.now.year).to_a.reverse %>
    <% year.unshift(["",""]) %>
    <div style="float:right">
      <%= link_to sprite_icon('add', l(:label_new_referral)), url_for(action: "edit"), class: "icon icon-add" %>
    </div>
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px 15px;">
      <span style="display: flex; align-items: center; gap: 5px;">
        <b><label style="white-space: nowrap;"><%= l(:label_referral) %></label></b>
        <%= text_field_tag "lead_name", session[controller_name].try(:[], :lead_name), size: 30 %>
      </span>
      <span style="display: flex; align-items: center; gap: 5px;">
        <b><label style="white-space: nowrap;"><%= l(:field_status) %></label></b>
        <%= select_tag "status", options_for_select({"": ""}.merge!(getLeadStatusArr).invert, selected: session[controller_name].try(:[], :status)) %>
      </span>
      <span style="display: flex; align-items: center; gap: 5px;">
        <b><label style="white-space: nowrap;"><%= l(:field_location) %></label></b>
        <%= select_tag "location_id", generic_options_for_select(WkLocation, nil, 'name', 'name', 'id', session[controller_name].try(:[], :location_id), true) %>
      </span>
      <span style="display: flex; align-items: center; gap: 5px;">
        <b><label style="white-space: nowrap;"><%= l(:label_pass_out) %></label></b>
        <%= select_tag "pass_out", options_for_select(year, selected: session[controller_name].try(:[], :pass_out)) %>
      </span>
      <span style="display: flex; align-items: center; gap: 5px;">
        <%= submit_tag l(:button_apply), class: "small", name: nil %>
        <%= link_to sprite_icon('reload', l(:button_clear)), {tab: controller_name, clear: true}, class: 'icon icon-reload' %>
      </span>
    </div>
  <% end %>
</fieldset>&nbsp;

<% if @entries.present? %>
  <%= render partial: "wklead/lead_list", locals: { entries: @entries } %>
	<% other_formats_links do |f| %>
		<%= f.link_to_with_query_parameters 'CSV', {} %>
	<% end %>
<% else %>
	<p class="nodata"><%= l(:label_no_data) %></p>
<% end %>