<%= stylesheet_link_tag 'wk-time', :plugin => "redmine_wktime" %>
<%= title l(:label_wkdevices) %>
<%= render partial: "wkcrmenumeration/render_settings_tabs" %>

<%= form_tag(wkdevices_path, method: :get, id: 'query_form') do %>
  <fieldset>
    <legend><%= l(:label_filter_plural) %></legend>
    <label for='status'><%= l(:field_status) %>:</label>
    <%= select_tag 'status', options_for_select([[l(:label_all), 'all'], [l(:label_device_status_pending), 'pending'], [l(:wk_status_approved), 'approved'], [l(:default_issue_status_rejected), 'rejected']], @status), class: 'small' %>
    
    <%= submit_tag l(:button_apply), :class => "small", :name => nil %>
    <%= link_to sprite_icon('reload', l(:button_clear)), wkdevices_path(clear: true), class: 'icon icon-reload' %>
  </fieldset>
<% end %>

<% if @devices.any? %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_user) %></th>
        <th><%= l(:label_device_id) %></th>
        <th><%= l(:label_device_brand) %></th>
        <th><%= l(:label_device_model) %></th>
        <th><%= l(:label_device_os_version) %></th>
        <th><%= l(:field_status) %></th>
        <th><%= l(:label_device_last_login) %></th>
        <th><%= l(:label_device_actions) %></th>
      </tr>
    </thead>
    <tbody>
      <% @devices.each do |device| %>
        <tr class="<%= cycle("odd", "even") %>">
          <td><%= link_to_user(device.user) %></td>
          <td><%= device.device_id %></td>
          <td><%= device.brand %></td>
          <td><%= device.model %></td>
          <td><%= device.os_version %></td>
          <td>
            <strong>
              <%= case device.status
                  when 'pending' then l(:label_device_status_pending)
                  when 'approved' then l(:wk_status_approved)
                  when 'rejected' then l(:default_issue_status_rejected)
                  end %>
            </strong>
          </td>
          <td><%= format_time(device.last_login_at) %></td>
          <td>
            <% if !device.approved? %>
              <%= link_to l(:button_wk_approve), wkdevice_path(device, status: 'approved', filter_status: @status), method: :put, class: 'icon icon-ok' %>
            <% end %>
            <% if !device.rejected? && !device.approved? %>
              <%= link_to l(:button_wk_reject), wkdevice_path(device, status: 'rejected', filter_status: @status), method: :put, class: 'icon icon-lock' %>
            <% end %>
            <% if device.approved? %>
              <%= link_to l(:button_wk_unapprove), wkdevice_path(device, status: 'pending', filter_status: @status), method: :put, class: 'icon icon-unlock' %>
            <% end %>
            <%= link_to sprite_icon('del'), wkdevice_path(device, filter_status: @status), method: :delete, data: { confirm: l(:text_are_you_sure) }, title: l(:button_delete) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
