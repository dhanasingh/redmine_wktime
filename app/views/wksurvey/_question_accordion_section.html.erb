<% group = f.object %>
<%
  # Build a set of all question IDs that are follow-ups (linked from a choice)
  all_questions = group.wk_survey_questions.sort_by { |qq| [qq.lft || 99999, qq.id || 99999] }
  follow_up_ids = Set.new
  _group_choice_ids = all_questions.flat_map { |qq| qq.wk_survey_choices.map(&:id) }.compact
  if _group_choice_ids.any?
    WkSurveyChoice.where(
      id: _group_choice_ids,
      follow_up_question_type: 'WkSurveyQuestion'
    ).where.not(follow_up_question_id: nil)
     .pluck(:follow_up_question_id).each { |fid| follow_up_ids.add(fid) }
  end
  question_builders_map = {}
  top_level_builders = []
%>

  <%
    _default_name_re = /\A(Group|Group-\d+)\z/i
    _has_meaningful_name = group.name.present? && !group.name.match?(_default_name_re)
  %>
  <% if _has_meaningful_name || !survey.persisted? %>
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 5px;" class="group-container-wrap">
      <tr>
      
        <td valign="top">
          <div class="group-accordion-item" style="font-size: 16px;" id="group-<%= group.id || 'new' %>">
            <%= f.hidden_field :id %>
            <%= f.hidden_field :sort_order, class: 'group-sort-order' %>

        <h3 class="group-accordion-header ed-section-head">
          <%= f.hidden_field :name, class: 'group-name-hidden' %>
          <span class="ed-sec-label group-num"><%= l(:label_group).to_s.upcase %></span>
          <span class="ed-sec-name group-name-editable"
                contenteditable="false"
                spellcheck="false"
                onclick="event.stopPropagation(); activateGroupNameEdit(this)"><%= group.name.presence || l(:label_group) %></span>
          <span class="ed-sec-count"><span class="ed-q-count"></span></span>
          <span class="ed-spacer"></span>
          <% unless isDisable %>
            <span class="ed-sec-actions group-header-actions" onclick="event.stopPropagation()">
              <button type="button" class="ed-iconbtn ed-danger group-header-del"
                      onclick="DeleteGroup(this)"
                      title="<%= l(:button_delete_group) %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
              </button>
            </span>
          <% end %>
        </h3>
        <div class="group-accordion-content">
          <div class="group-questions">
            <%# Collect all form builders; store persisted ones in map, all top-level in list %>
            <% f.fields_for :wk_survey_questions, all_questions do |qb| %>
              <% question_builders_map[qb.object.id] = qb if qb.object.id.present? %>
              <% top_level_builders << qb unless follow_up_ids.include?(qb.object.id) %>
            <% end %>

            <%# Shared Set of rendered question IDs %>
            <% r_ids = local_assigns[:rendered_ids] || Set.new %>

            <% top_level_builders.each do |qb| %>
              <%= render partial: 'question_fields', locals: { f: qb, isDisable: isDisable, question_builders_map: question_builders_map, rendered_ids: r_ids } %>
            <% end %>

            <template id="question-template">
              <%= f.fields_for :wk_survey_questions, WkSurveyQuestion.new.tap { |nq| nq.wk_survey_choices.build }, child_index: "NEW_RECORD" do |qb| %>
                <%= render partial: 'question_fields', locals: { f: qb, isDisable: isDisable } %>
              <% end %>
            </template>

            <% unless isDisable %>
              <div class="add-question-link">
                <%= link_to sprite_icon('add', l(:button_add_question)), 'javascript:void(0)', onclick: 'addQuestions(this)', class: 'icon icon-add' %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </td>
  </tr>
</table>
  <% else %>
    <%
      all_questions_ug = group.wk_survey_questions.sort_by { |qq| [qq.lft || 99999, qq.id || 99999] }
      follow_up_ids_ug = Set.new
      _ug_choice_ids = all_questions_ug.flat_map { |qq| qq.wk_survey_choices.map(&:id) }.compact
      if _ug_choice_ids.any?
        WkSurveyChoice.where(
          id: _ug_choice_ids,
          follow_up_question_type: 'WkSurveyQuestion'
        ).where.not(follow_up_question_id: nil)
         .pluck(:follow_up_question_id).each { |fid| follow_up_ids_ug.add(fid) }
      end
      question_builders_map_ug = {}
      top_level_builders_ug = []
    %>
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 5px;" class="group-container-wrap">
      <tr>
        <td valign="top">
          <div class="group-ungrouped-questions" style="margin-bottom: 10px;">
            <%= f.hidden_field :id %>
            <%= f.hidden_field :sort_order, class: 'group-sort-order' %>
            <%= f.hidden_field :_destroy, class: 'group-destroy-field', value: 0 %>
    <div class="group-questions ungrouped-section">
      <% f.fields_for :wk_survey_questions, all_questions_ug do |qb| %>
        <% question_builders_map_ug[qb.object.id] = qb if qb.object.id.present? %>
        <% top_level_builders_ug << qb unless follow_up_ids_ug.include?(qb.object.id) %>
      <% end %>

      <% r_ids_ug = local_assigns[:rendered_ids] || Set.new %>
      <% top_level_builders_ug.each do |qb| %>
        <%= render partial: 'question_fields', locals: { f: qb, isDisable: isDisable, question_builders_map: question_builders_map_ug, rendered_ids: r_ids_ug } %>
      <% end %>

      <template id="question-template">
        <%= f.fields_for :wk_survey_questions, WkSurveyQuestion.new.tap { |q| q.wk_survey_choices.build } ,child_index: "NEW_RECORD" do  |q| %>
          <%= render partial: 'question_fields', locals: { f: q, isDisable: isDisable } %>
        <% end %>
      </template>

      <% unless isDisable %>
        <div class="add-question-link" style="display:none;">
          <%= link_to sprite_icon('add', l(:button_add_question)), 'javascript:void(0)', onclick: 'addQuestions(this)', class: 'icon icon-add' %>
        </div>
      <% end %>
      </div>
    </div>
    </td>
  </tr>
</table>
  <% end %>