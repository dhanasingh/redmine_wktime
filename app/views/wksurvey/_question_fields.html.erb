<script type="text/javascript">
  var addFollowupHtml = '<a href="javascript:void(0)" onclick="addFollowUpQuestion(this)" class="fu-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg><%= l(:label_add_followup) %><\/a>';
  var unlinkFollowupHtml = '<a href="javascript:void(0)" onclick="removeFollowUpLink(this)" class="fu-unlink icon-unlink" title="Unlink">unlink ×<\/a>';
  var linkedLabelHtml = '';
  var addChoice = '<a href="javascript:void(0)" onclick="addChoiceRow(this)" class="add-choice icon-add"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg><%= l(:button_add_choice) %><\/a>';
  var pointsText = '<%= l(:label_points) %>';
  var FollowUpLinkText = '<%= l(:label_add_link_followup) %>';
  var LinkFollowUpText = '<%= l(:label_link_followup_question) %>';
  var AddFollowUpText = '<%= l(:label_add_followup_question) %>';
  var FollowUpText = '<%= l(:label_followup_question) %>';
  var delIconSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>';
</script>
<% q = f.object %>
<% is_child_question = q.id.present? ? q.triggering_choices.any? : false %>
<% current_rendered_ids = local_assigns[:rendered_ids] || Set.new %>
<% current_rendered_ids.add(q.id) if q.id.present? %>
<% isInlineFollowup = local_assigns[:is_inline_followup] == true %>
<%
  qtype     = q.question_type || 'RB'
  is_choice = %w[RB CB].include?(qtype)
  is_text   = %w[TB MTB].include?(qtype)
  type_color_class = case qtype when 'RB' then 'rb' when 'CB' then 'cb' when 'TB' then 'tb' when 'MTB' then 'mtb' else 'rb' end
  glyph_class = qtype == 'CB' ? 'check' : 'radio'
  affix_open  = q.header.to_s.strip.length > 0 || q.footer.to_s.strip.length > 0
%>

<% if isInlineFollowup %>
  <div class="surveyquestion child-question qrow qrow-inline ed-qtype-<%= qtype %>" style="margin-bottom:5px;">
<% else %>
  <div class="surveyquestion qrow ed-qtype-<%= qtype %> <%= is_child_question ? 'child-question' : '' %>" style="margin-bottom:10px;">
<% end %>

  <%= f.hidden_field :id %>
  <%= f.hidden_field :sort_order, class: 'question-sort-order' %>
  <% unless isDisable %>
    <%= f.check_box :_destroy, class: 'hide', style: 'display:none' %>
  <% end %>

  <% unless isInlineFollowup %>
    <div class="q-gutter">
      <div class="q-num index-num">
        <b>__QUESTION_INDEX__</b>
      </div>
    </div>
  <% end %>

  <div class="q-body">
    <% if isInlineFollowup %>
      <% choice_label = local_assigns[:choice_name].to_s.strip %>
      <div class="fu-tag">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        <span class="fu-tag-base">FOLLOW-UP</span>
        <% if choice_label.present? %><span class="fu-tag-choice">· <%= choice_label %></span><% end %>
      </div>
    <% end %>

    <div class="q-toprow">
      <% if isInlineFollowup %>
        <span class="childIndexNo q-num q-num-inline"></span>
      <% end %>
      <span class="required-star">*</span><%= f.text_field :name, size: 40, maxlength: 255, disabled: isDisable, class: 'q-title question-name-input', placeholder: l(:label_question_name) %>
      <%= f.select :question_type,
                   options_for_select(getQuestionType, selected: qtype),
                   {}, {
                     onchange: 'questionTypeChanged(this)',
                     disabled: isDisable,
                     class: "q-type-select #{type_color_class}"
                   } %>
      <% unless isDisable %>
        <span class="q-actions">
          <a href="javascript:void(0)" title="<%= l(:button_delete_question) %>" onclick="DeleteQuestion(this)" class="iconbtn danger icon icon-del">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
          </a>
        </span>
      <% end %>
    </div>

    <%# ===================== RB/CB: choices block ===================== %>
    <%# <fieldset disabled> when not the active type, so its fields are excluded from submission (HTML5 native cascade). %>
    <fieldset class="choices" <%= 'disabled' unless is_choice %> style="border:0;padding:0;margin:0;min-inline-size:0;<%= 'display:none;' unless is_choice %>">
      <%= f.fields_for :wk_survey_choices, f.object.wk_survey_choices.presence || [f.object.wk_survey_choices.build] do |c| %>
        <% next if is_text && c.object.name.blank? && c.object.points.blank? %>
        <% has_fu = c.object.follow_up_question_id.present? %>
        <div class="choice choice-row">
          <span class="glyph <%= glyph_class %>"></span>
          <%= c.hidden_field :id %>
          <%= c.text_field :name, size: 40, maxlength: 100, disabled: isDisable, class: 'choice-text' %>
          <span class="pts choice-points-cell">
            <%= l(:label_points) %>
            <%= c.text_field :points, size: 5, maxlength: 10, disabled: isDisable %>
          </span>
          <span class="choice-followup-actions" style="display:inline-flex;align-items:center;gap:4px;">
            <%= c.check_box :_destroy, class: 'hide', style: 'display:none' %>
            <% if has_fu %>
              <%= c.hidden_field :follow_up_question_id, class: 'followup-val' %>
              <% unless isDisable %>
                <span class="fu-linked-label"></span><%= link_to "unlink ×", 'javascript:void(0)', onclick: 'removeFollowUpLink(this)', class: 'fu-unlink icon-unlink', title: 'Unlink' %>
              <% end %>
            <% else %>
              <% unless isDisable %>
                <a href="javascript:void(0)" onclick="addFollowUpQuestion(this)" class="fu-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg><%= l(:label_add_followup) %></a>
              <% end %>
            <% end %>
          </span>
          <% unless isDisable %>
            <a href="javascript:void(0)" onclick="DeleteChoice(this)" title="<%= l(:button_delete) %>" class="iconbtn danger icon icon-del">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
            </a>
          <% end %>
        </div>

        <%# Render inline follow-up for this specific choice %>
        <% if is_choice && local_assigns[:question_builders_map] && c.object.follow_up_question_id.present? %>
          <% fu_id = c.object.follow_up_question_id %>
          <% fu_builder = question_builders_map[fu_id] %>
          <% if fu_builder && !current_rendered_ids.include?(fu_id) %>
            <div class="followup follow-up-container followup-inline followup-inline-row" data-choice-name="<%= c.object.name || 'followup' %>">
              <%= render partial: 'question_fields', locals: { f: fu_builder, isDisable: isDisable, question_builders_map: question_builders_map, rendered_ids: current_rendered_ids, is_inline_followup: true, choice_name: c.object.name } %>
            </div>
          <% end %>
        <% end %>
      <% end %>

      <% unless isDisable %>
        <a href="javascript:void(0)" class="add-choice icon icon-add" onclick="addChoiceRow(this)" style="<%= 'display:none;' unless is_choice %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          <%= l(:button_add_choice) %>
        </a>
      <% end %>
    </fieldset>

    <%# ===================== TB/MTB: hidden choice container ===================== %>
    <div class="tb-mtb-choice tb-mtb-followup-adder-row" style="<%= 'display:none;' unless is_text %>">

      <%# TB/MTB inline follow-up render %>
      <% if local_assigns[:question_builders_map] && q.id.present? && is_text %>
        <% q.wk_survey_choices.each do |choice| %>
          <% if choice.follow_up_question_id.present? && question_builders_map[choice.follow_up_question_id] && !current_rendered_ids.include?(choice.follow_up_question_id) %>
            <div class="followup follow-up-container followup-inline followup-inline-row" data-choice-name="<%= choice.name || 'followup' %>">
              <%= render partial: 'question_fields', locals: { f: question_builders_map[choice.follow_up_question_id], isDisable: isDisable, question_builders_map: question_builders_map, rendered_ids: current_rendered_ids, is_inline_followup: true, choice_name: choice.name } %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%# ===================== q-tools footer ===================== %>
    <div class="q-tools question-footer">
      <label class="chk"><%= f.check_box :is_mandatory, disabled: isDisable %><span><%= l(:label_mandatory) %></span></label>
      <label class="chk"><%= f.check_box :not_in_report, disabled: isDisable %><span><%= l(:label_not_rpt) %></span></label>
      <label class="chk revieweronly"><%= f.check_box :is_reviewer_only, disabled: isDisable %><span><%= l(:label_reviewer_only) %></span></label>

      <%# TB/MTB: points + add-followup live in the tools footer — always rendered, <fieldset disabled> excludes it from submission unless active. %>
      <fieldset class="text-points tb-mtb-tools" <%= 'disabled' unless is_text %> style="border:0;padding:0;margin:0;margin-left:auto;min-inline-size:0;<%= is_text ? 'display:inline-flex;' : 'display:none;' %>align-items:center;gap:10px;">
        <%= f.fields_for :wk_survey_choices, f.object.wk_survey_choices.presence || [f.object.wk_survey_choices.build] do |c| %>
          <%= c.hidden_field :id %>
          <%= c.hidden_field :name, maxlength: 100 %>
          <%= c.check_box :_destroy, class: 'hide', style: 'display:none' %>
          <% if c.object.follow_up_question_id.present? %>
            <%= c.hidden_field :follow_up_question_id, class: 'followup-val' %>
          <% end %>
          <span class="pts"><%= l(:label_points) %>
            <%= c.text_field :points, size: 5, maxlength: 10, disabled: isDisable %>
          </span>
        <% end %>
        <span class="tb-mtb-followup-cell" style="display:inline-flex;align-items:center;gap:4px;">
          <%= f.fields_for :wk_survey_choices, f.object.wk_survey_choices.presence || [f.object.wk_survey_choices.build] do |c| %>
            <span class="fu-linked-label"></span>
            <% if c.object.follow_up_question_id.present? %>
              <% unless isDisable %>
                <%= link_to "unlink ×", 'javascript:void(0)', onclick: 'removeFollowUpLink(this)', class: 'fu-unlink icon-unlink', title: 'Unlink' %>
              <% end %>
            <% else %>
              <% unless isDisable %>
                <a href="javascript:void(0)" onclick="addFollowUpQuestion(this)" class="fu-link"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg><%= l(:label_add_followup) %></a>
              <% end %>
            <% end %>
          <% end %>
        </span>
      </fieldset>

      <span class="q-affix-toggle intro-toggle" onclick="toggleAffix(this)"><%= "#{affix_open ? '− ' : '+ '}#{l(:label_pre_text)} / #{l(:label_post_text)}" %></span>
    </div>

    <div class="q-affix intro-closing-panel" style="<%= affix_open ? 'display:grid;' : 'display:none;' %>">
      <label><%= l(:label_pre_text) %></label>
      <%= f.text_field :header, size: 40, maxlength: 255, disabled: isDisable, class: 'input' %>
      <label><%= l(:label_post_text) %></label>
      <%= f.text_field :footer, size: 40, maxlength: 255, disabled: isDisable, class: 'input' %>
    </div>
  </div>
</div>
